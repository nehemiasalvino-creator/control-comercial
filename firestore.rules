rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().status == "active"; }
    function superAdmin() { return active() && profile().role == "super_admin"; }
    function nationalViewer() { return active() && profile().role == "national_viewer"; }
    function districtUploader() { return active() && profile().role == "district_uploader"; }
    function districtViewer() { return active() && profile().role == "district_viewer"; }
    function zoneAdmin() { return active() && profile().role == "zone_admin"; }
    function districtAdmin() { return active() && profile().role == "district_admin"; }
    function sameScope(data) { return profile().districtId == data.districtId && profile().zoneId == data.zoneId; }
    function sameDistrict(data) { return profile().districtId == data.districtId; }

    match /districts/{districtId} {
      allow read: if active();
      allow create, update: if superAdmin();
      allow delete: if false;
    }

    match /zones/{zoneId} {
      allow read: if active();
      allow create, update: if superAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || superAdmin());
      allow create, update, delete: if superAdmin();
    }

    match /programmingDays/{programId} {
      allow read: if active() && (superAdmin() || nationalViewer() || ((districtAdmin() || districtViewer()) && sameDistrict(resource.data)) || sameScope(resource.data));
      allow create: if (superAdmin() || (districtAdmin() && sameDistrict(request.resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(request.resource.data)))
        && request.time < request.resource.data.editableUntil;
      allow update: if (superAdmin() || (districtAdmin() && sameDistrict(resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(resource.data)))
        && request.time < resource.data.editableUntil
        && request.resource.data.editableUntil == resource.data.editableUntil;
      allow delete: if false;
    }

    match /receiptBusinessUnits/{unitId} {
      allow read: if active() && (superAdmin() || nationalViewer() || ((districtAdmin() || districtViewer()) && sameDistrict(resource.data)) || sameScope(resource.data));
      allow create: if superAdmin() || (districtAdmin() && sameDistrict(request.resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(request.resource.data));
      allow update: if superAdmin() || (districtAdmin() && sameDistrict(resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(resource.data));
      allow delete: if false;
    }

    match /receiptSettings/{districtId} {
      allow read: if active() && (superAdmin() || nationalViewer() || profile().districtId == districtId);
      allow create, update: if superAdmin() || ((districtAdmin() || zoneAdmin() || districtUploader()) && profile().districtId == districtId);
      allow delete: if false;
    }

    match /officialReceiptDeliveries/{deliveryId} {
      allow read: if active() && (superAdmin() || nationalViewer() || ((districtAdmin() || districtViewer()) && sameDistrict(resource.data)) || sameScope(resource.data));
      allow create: if superAdmin() || (districtAdmin() && sameDistrict(request.resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(request.resource.data));
      allow update: if superAdmin() || (districtAdmin() && sameDistrict(resource.data)) || ((zoneAdmin() || districtUploader()) && sameScope(resource.data));
      allow delete: if false;
    }

    match /proformaClients/{clientId} {
      allow read: if active() && (superAdmin() || nationalViewer() || sameScope(resource.data));
      allow create: if superAdmin() || (districtUploader() && sameScope(request.resource.data));
      allow update: if superAdmin() || (districtUploader() && sameScope(resource.data));
      allow delete: if false;
    }

    match /proformas/{proformaId} {
      allow get: if active() && (superAdmin() || nationalViewer() || sameScope(resource.data)
        || (districtUploader() && proformaId.matches(profile().districtId + '_' + profile().zoneId + '_.*')));
      allow list: if active() && (superAdmin() || nationalViewer() || sameScope(resource.data));
      allow create, update: if superAdmin() || (districtUploader() && sameScope(request.resource.data));
      allow delete: if false;
    }

    match /proformaCounters/{counterId} {
      allow read: if active() && (superAdmin() || sameScope(resource.data));
      allow create: if superAdmin() || (districtUploader() && sameScope(request.resource.data));
      allow update: if superAdmin() || (districtUploader() && sameScope(resource.data));
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
